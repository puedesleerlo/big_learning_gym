# SQLite is a convenient single-user local default. Docker uses PostgreSQL.
GYM_DATABASE_URL=sqlite:///data/gym.db
GYM_DATA_DIR=data
GYM_MODELS_CONFIG=config/models.json
MOONSHOT_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
# Required when serving beyond localhost. Send as Authorization: Bearer.
GYM_ACCESS_TOKEN=
